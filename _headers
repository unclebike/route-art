# Check for a new build on every load so updates land without a hard refresh.
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vendored libraries are pinned by version; cache them hard.
/vendor/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
